# Токены API сервиса sqlbrc (auth.token_file): одна строка — один токен.
#
# Формат строки: <логин>:<токен>. Логин попадает в журнал задач как оператор,
# поэтому по записи видно, кто запустил операцию — робот «ci» или человек.
#
# Установка:
#   install -m 0600 deploy/tokens.example /etc/sqlbrc/tokens
#   # в конфиге: auth: { token_file: "/etc/sqlbrc/tokens" }
#
# Требования к токену: 32 символа и больше. Короткий подбирается перебором,
# а сервис не ограничивает частоту запросов к API. Строки, начинающиеся с «#»,
# и пустые строки игнорируются, поэтому файл можно комментировать.
#
# Генерация токена: openssl rand -hex 32
#
# Ниже — пример закомментированной строки: замените значение своим токеном
# и уберите «#», иначе файл останется пустым (и доступ к API будет закрыт).
# ci:ПРИМЕР-замените-на-значение-из-openssl-rand-hex-32
