[Unit]
Description=sqlbrc: ежедневный бэкап обслуживаемых баз

[Timer]
# Ночь: дампы не мешают работе стендов.
OnCalendar=*-*-* 02:30:00
# Пропущенный запуск выполняется после включения машины: пропускать бэкап из-за
# перезагрузки нельзя.
Persistent=true
# Разброс времени: сервис не должен просыпаться ровно вместе с другими задачами.
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
